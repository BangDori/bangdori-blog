{
  "name": "bangdori-blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:user-web": "pnpm --filter user-web dev",
    "build:user-web": "pnpm --filter user-web build",
    "start:user-web": "pnpm --filter user-web start",
    "check:user-web": "pnpm --filter user-web check",
    "check:user-web:ci": "pnpm --filter user-web check:ci",
    "dev:server": "pnpm --filter server dev",
    "build:server": "pnpm --filter server build",
    "start:server": "pnpm --filter server start",
    "check:server": "pnpm --filter server check",
    "check:server:ci": "pnpm --filter server check:ci",
    "docker:build": "docker compose --env-file apps/user-web/.env -f infra/docker/docker-compose.local.yml build",
    "docker:up": "docker compose --env-file apps/user-web/.env -f infra/docker/docker-compose.local.yml up --build -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.local.yml down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.local.yml logs -f",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@evilmartians/lefthook": "^2.1.6"
  }
}
