{
  "name": "@bangdori-blog/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "typeorm:ds": "pnpm typeorm -d src/data-source.ts",
    "migration:generate": "pnpm typeorm:ds migration:generate",
    "migration:create": "pnpm typeorm migration:create",
    "migration:run": "pnpm typeorm:ds migration:run",
    "migration:revert": "pnpm typeorm:ds migration:revert",
    "seed": "tsx src/seed.ts",
    "check": "biome check --write .",
    "check:ci": "biome check ."
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.20.0",
    "typeorm": "^0.3.23"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@types/node": "^24.0.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
