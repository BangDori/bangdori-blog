{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "typeorm:ds": "pnpm typeorm -d src/database/data-source.ts",
    "migration:generate": "pnpm typeorm:ds migration:generate",
    "migration:create": "pnpm typeorm migration:create",
    "migration:run": "pnpm typeorm:ds migration:run",
    "migration:revert": "pnpm typeorm:ds migration:revert",
    "seed": "tsx src/database/seed.ts",
    "check": "biome check --write .",
    "check:ci": "biome check ."
  },
  "dependencies": {
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.19",
    "@nestjs/platform-express": "11.1.19",
    "@nestjs/typeorm": "11.0.1",
    "nestjs-pino": "4.6.1",
    "pg": "8.20.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.28"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@nestjs/cli": "11.0.21",
    "@types/node": "24.12.2",
    "@types/pg": "8.20.0",
    "dotenv": "17.4.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
