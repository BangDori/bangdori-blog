{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "typeorm:ds": "pnpm typeorm -d src/database/data-source.ts",
    "migration:generate": "pnpm typeorm:ds migration:generate",
    "migration:create": "pnpm typeorm migration:create",
    "migration:run": "pnpm typeorm:ds migration:run",
    "migration:revert": "pnpm typeorm:ds migration:revert",
    "seed": "tsx src/database/seed.ts",
    "check": "biome check --write .",
    "check:ci": "biome check ."
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/typeorm": "^11.0.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.23"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@nestjs/cli": "^11.0.7",
    "@types/node": "^24.0.1",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
