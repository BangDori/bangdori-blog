{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build && tsc-alias -p tsconfig.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "typeorm:ds": "pnpm typeorm -d src/database/data-source.ts",
    "migration:generate": "pnpm typeorm:ds migration:generate",
    "migration:create": "pnpm typeorm migration:create",
    "migration:run": "pnpm typeorm:ds migration:run",
    "migration:revert": "pnpm typeorm:ds migration:revert",
    "seed": "tsx src/database/seed.ts",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "jest --config jest.unit.config.js",
    "test:integration": "jest --config jest.integration.config.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.19",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.1.19",
    "@nestjs/typeorm": "11.0.1",
    "argon2": "^0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "^1.4.7",
    "nestjs-pino": "4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "8.20.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.28"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@nestjs/cli": "11.0.21",
    "@nestjs/testing": "11.1.19",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.12.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "8.20.0",
    "@types/supertest": "^7.2.0",
    "dotenv": "17.4.2",
    "jest": "30.2.0",
    "supertest": "^7.2.2",
    "testcontainers": "^11.14.0",
    "ts-jest": "29.4.4",
    "tsc-alias": "1.8.17",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
