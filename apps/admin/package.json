{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3001",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3001",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "knip": "knip",
    "knip:ci": "knip --no-progress --reporter compact",
    "circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src/",
    "circular:ci": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src/ --warning"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "5.62.0",
    "clsx": "2.1.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.76.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.15.0",
    "remark-gfm": "4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "2.5.5",
    "tiny-invariant": "^1.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bangdori/ui": "workspace:*",
    "@biomejs/biome": "2.4.14",
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.2.4",
    "@tanstack/react-query-devtools": "5.62.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^10.4.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "knip": "^6.14.2",
    "madge": "^8.0.0",
    "tailwindcss": "4.2.4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "6.4.2"
  }
}
